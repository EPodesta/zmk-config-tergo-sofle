#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/* Layers */
#define BASE      0
#define OTHER     1
#define SYMB_NAV  3
#define ADJUST    4
#define MEDIA     5
#define NUMPAD    6
#define MOUSE     7

/* Tuning (Miryoku-ish hold-tap) */
#define TAPPING_TERM 280
#define QUICK_TAP    175

/ {
  /* Behaviors: Miryoku-style home-row mods + layer-tap */
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HM";
      #binding-cells = <2>;
      tapping-term-ms = <TAPPING_TERM>;
      quick-tap-ms = <QUICK_TAP>;
      flavor = "balanced";
      bindings = <&kp>, <&kp>;
    };

    lt: layer_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "LT";
      #binding-cells = <2>;
      tapping-term-ms = <TAPPING_TERM>;
      quick-tap-ms = <QUICK_TAP>;
      flavor = "balanced";
      bindings = <&mo>, <&kp>;
    };
  };

  /* Combos */
  combos {
    compatible = "zmk,combos";

    combo_dongle_bootloader {
      timeout-ms = <30>;
      key-positions = <50 51 58 59>;
      bindings = <&bootloader>;
    };

    combo_unlock_zmk_studio {
      timeout-ms = <30>;
      key-positions = <50 59>;
      bindings = <&studio_unlock>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    /*
     * BASE: Colemak-DH + Miryoku home-row mods
     *
     * Colemak-DH (ANSI):
     *  Q W F P B   J L U Y ;
     *  A R S T G   M N E I O
     *  Z X C D V   K H , . /
     *
     * Home-row mods (Miryoku style):
     *  A=GUI, R=ALT, S=CTRL, T=SHIFT
     *  N=SHIFT, E=CTRL, I=ALT, O=GUI
     */
    base_layer {
      display-name = "Base";
      bindings = <
#ifdef USE_INTERNATIONAL_LAYOUT
        /* ┌──────────── left ────────────┐           ┌──────────── right ───────────┐ */
        &kp ESC   &kp Q   &kp W   &kp F   &kp P   &kp B             &kp J   &kp L   &kp U     &kp Y   &kp SEMI  &kp BSPC
        &kp TAB   &kp A   &kp R   &kp S   &kp T   &kp G             &kp M   &kp N   &kp E     &kp I   &kp O     &kp QUOT
        &kp LSHFT &kp Z   &kp X   &kp C   &kp D   &kp V             &kp K   &kp H   &kp COMMA &kp DOT &kp FSLH  &kp ENTER
        &kp LCTRL &none   &none   &none   &none   &none  &mo MEDIA  &mo ADJUST  &none &none &none &none &none &none

        /* thumbs (5 + 5) */
                          &none   &none   &lt NUMPAD SPACE  &lt SYMB_NAV ENTER   &lt MEDIA TAB
                          &lt MOUSE BSPC    &kp DEL          &none              &none           &none
#else
        /* ABNT2 fallback (you said you use ANSI; leaving this as a safe fallback) */
        &kp ESC   &kp Q   &kp W   &kp F   &kp P   &kp B             &kp J   &kp L   &kp U     &kp Y   &kp SEMI  &kp BSPC
        &kp TAB   &kp A   &kp R   &kp S   &kp T   &kp G             &kp M   &kp N   &kp E     &kp I   &kp O     &kp QUOT
        &kp LSHFT &kp Z   &kp X   &kp C   &kp D   &kp V             &kp K   &kp H   &kp COMMA &kp DOT &kp FSLH  &kp ENTER
        &kp LCTRL &none   &none   &none   &none   &none  &mo MEDIA  &mo ADJUST  &none &none &none &none &none &none

                          &none   &none   &lt NUMPAD SPACE  &lt SYMB_NAV ENTER   &lt MEDIA TAB
                          &lt MOUSE BSPC    &kp DEL          &none              &none           &none
#endif
      >;

      /* Encoder */
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /*
     * OTHER: QWERTY fallback (no mods), in case you want to toggle layouts
     * (kept simple; you can customize later)
     */
    other_layer {
      display-name = "Other";
      bindings = <
#ifdef USE_INTERNATIONAL_LAYOUT
        &kp ESC   &kp Q   &kp W   &kp E   &kp R   &kp T             &kp Y   &kp U   &kp I     &kp O   &kp P     &kp BSPC
        &kp TAB   &kp A   &kp S   &kp D   &kp F   &kp G             &kp H   &kp J   &kp K     &kp L   &kp SEMI  &kp QUOT
        &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B             &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH  &kp ENTER
        &kp LCTRL &none   &none   &none   &none   &none  &mo MEDIA  &mo ADJUST  &none &none &none &none &none &none

                          &none   &none   &kp SPACE        &kp ENTER         &kp TAB
                          &kp BSPC &kp DEL                &none             &none           &none
#else
        &kp ESC   &kp Q   &kp W   &kp E   &kp R   &kp T             &kp Y   &kp U   &kp I     &kp O   &kp P     &kp BSPC
        &kp TAB   &kp A   &kp S   &kp D   &kp F   &kp G             &kp H   &kp J   &kp K     &kp L   &kp SEMI  &kp QUOT
        &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B             &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH  &kp ENTER
        &kp LCTRL &none   &none   &none   &none   &none  &mo MEDIA  &mo ADJUST  &none &none &none &none &none &none

                          &none   &none   &kp SPACE        &kp ENTER         &kp TAB
                          &kp BSPC &kp DEL                &none             &none           &none
#endif
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /*
     * SYMB_NAV: kept from your original (works fine with Colemak-DH)
     * You can refine later to match Miryoku's separated NAV/SYM if you want.
     */
    symb_nav_layer {
      display-name = "SymNv";
      bindings = <
#ifdef USE_INTERNATIONAL_LAYOUT
        &trans    &kp F1        &kp F2       &kp F3        &kp F4       &kp F5                        &kp F6    &kp F7       &kp F8    &kp F9        &kp F10           &kp F11
        &trans    &kp GRAVE     &kp LS(N6)   &kp KP_PLUS   &kp LS(LBKT) &kp LS(RBKT)                  &kp PG_UP &kp HOME     &kp UP    &kp END       &kp INS           &kp F12
        &trans    &kp LS(GRAVE) &kp EQUAL    &kp KP_MINUS  &kp LS(N9)   &kp LS(N0)                    &kp PG_DN &kp LEFT     &kp DOWN  &kp RIGHT     &kp PSCRN         &none
        &trans    &kp NUBS      &kp LS(NUBS) &kp LS(MINUS) &kp LBKT     &kp RBKT   &trans    &trans   &kp CAPS  &kp LC(LEFT) &kp ESC   &kp LC(RIGHT) &kp PAUSE_BREAK   &none

                              &trans       &trans        &trans       &trans     &trans    &trans   &trans    &trans       &trans    &trans
#else
        &trans    &kp F1        &kp F2       &kp F3        &kp F4       &kp F5                        &kp F6    &kp F7       &kp F8    &kp F9        &kp F10           &kp F11
        &trans    &kp GRAVE     &kp LS(N6)   &kp KP_PLUS   &kp LBKT     &kp NUHS                      &kp PG_UP &kp HOME     &kp UP    &kp END       &kp INS           &kp F12
        &trans    &kp LS(GRAVE) &kp EQUAL    &kp KP_MINUS  &kp LS(N9)   &kp LS(N0)                    &kp PG_DN &kp LEFT     &kp DOWN  &kp RIGHT     &kp PSCRN         &none
        &trans    &kp NUBS      &kp LS(NUBS) &kp LS(MINUS) &kp RBKT     &kp LS(RBKT) &trans   &trans  &kp CAPS  &kp LC(LEFT) &kp ESC   &kp LC(RIGHT) &kp PAUSE_BREAK   &none

                              &trans       &trans        &trans       &trans     &trans   &trans  &trans    &trans       &trans    &trans
#endif
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /*
     * ADJUST: kept from your original, but I removed ADEPT toggle
     * (you can jump between BASE and OTHER)
     */
    adjust_layer {
      display-name = "Confg";
      bindings = <
        &studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                 &none    &none   &none          &none   &none   &none
        &none          &none         &none         &none         &none         &none                         &none    &none   &bt BT_CLR_ALL &none   &none   &none
        &none          &none         &none         &out OUT_TOG  &none         &none                         &none    &none   &bt BT_CLR     &none   &none   &none
        &bootloader    &none         &to BASE      &to OTHER     &none         &none     &trans    &trans    &none    &none   &none          &none   &none   &bootloader

                     &trans       &trans       &trans       &trans       &trans    &trans    &trans    &trans    &trans  &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /* MEDIA: kept */
    media_layer {
      display-name = "Media";
      bindings = <
        &trans    &trans    &trans    &trans      &trans    &trans                        &trans    &trans       &trans     &trans       &trans  &trans
        &trans    &none     &none     &none       &none     &none                         &none     &none        &none      &none        &none   &trans
        &trans    &none     &none     &none       &none     &none                         &none     &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &none   &trans
        &trans    &none     &none     &none       &none     &none      &trans    &trans   &none     &kp C_PREV   &kp C_PP   &kp C_NEXT   &none   &trans

                    &trans    &trans      &trans    &trans     &trans    &trans   &trans    &trans       &trans     &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /* NUMPAD: kept */
    numpad_layer {
      display-name = "NumPd";
      bindings = <
        &trans    &trans    &trans    &trans      &trans    &trans                        &trans    &kp KP_NLCK &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS   &trans
        &trans    &none     &none     &none       &none     &none                         &none     &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS    &trans
        &trans    &none     &none     &none       &none     &none                         &none     &kp KP_N4   &kp KP_N5     &kp KP_N6        &kp KP_PLUS    &trans
        &trans    &none     &none     &none       &none     &none      &trans    &trans   &none     &kp KP_N1   &kp KP_N2     &kp KP_N3        &kp KP_ENTER   &trans

                    &trans    &trans      &trans    &trans     &trans    &trans   &trans    &kp KP_N0   &kp KP_N0     &kp KP_DOT
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /* MOUSE: kept */
    mouse_layer {
      display-name = "Mouse";
      bindings = <
        &trans    &trans    &trans    &trans      &trans     &trans                          &trans         &trans         &trans         &trans          &trans    &trans
        &trans    &none     &none     &none       &none      &none                           &msc SCRL_UP   &none          &mmv MOVE_UP   &none           &none     &trans
        &trans    &kp LGUI  &kp LALT  &kp LCTRL   &kp LSHFT  &none                           &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none     &trans
        &trans    &none     &none     &none       &none      &none      &trans    &trans      &none          &none          &none          &none           &none     &trans

                    &trans    &trans      &trans     &trans    &trans    &mkp RCLK   &mkp LCLK      &mkp MCLK      &trans         &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    /* Extra layers reserved for ZMK Studio */
    extra1 { status = "reserved"; };
    extra2 { status = "reserved"; };
    extra3 { status = "reserved"; };
    extra4 { status = "reserved"; };
    extra5 { status = "reserved"; };
    extra6 { status = "reserved"; };
    extra7 { status = "reserved"; };
    extra8 { status = "reserved"; };
  };
};
